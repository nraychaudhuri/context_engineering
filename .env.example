# Environment variables for the attention_recitation agent
# Copy this file to .env and fill in your actual API keys

# OpenAI API Key (required for ChatOpenAI model)
OPENAI_API_KEY=your_openai_api_key_here

# Exa API Key (required for web search functionality)
EXA_API_KEY=your_exa_api_key_here

# Tavily API Key (optional, for additional search capabilities)
TAVILY_API_KEY=your_tavily_api_key_here


# Optional: Model configuration
# MODEL_NAME=gpt-4.1-mini
# TEMPERATURE=0
